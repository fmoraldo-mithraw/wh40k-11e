          </costs>
          <profiles>
            <profile name="Plaguesight" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="fdac-9184-0120-bbf5">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model makes an attack that targets an Afflicted unit, you can re-roll the Hit roll.</characteristic>
              </characteristics>
            </profile>
