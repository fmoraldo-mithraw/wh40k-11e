        <selectionEntry type="upgrade" import="true" name="Plaguesight" hidden="false" id="3c79-3f9a-c13f-b5bb">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f898-2532-1a99-22b7" includeChildSelections="false"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Diplomatic Power" typeId="4d7c-04b6-8a79-837f" value="0"/>
