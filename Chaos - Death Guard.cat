        <constraint type="min" value="1" field="selections" scope="roster" shared="true" id="32f9-e593-2ef8-76c7" includeChildSelections="true"/>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="ca00-bef5-3732-847b" includeChildSelections="true"/>
      </constraints>
