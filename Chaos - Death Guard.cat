      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Foul Infusion" hidden="false" id="a510-fd8e-2713-435f">
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="10"/>
            <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
