              <profiles>
                <profile name="Casket of Corruption" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="7dfd-a008-f52d-263e">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">The bearer has the Deadly Demise D3 ability. In addition, at the end of the battle, if the bearer&apos;s unit is wholly within your opponent&apos;s deployment zone, when you next follow the Path of Contagion, you can skip the Counteragents step.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="9a7b-03b5-97d6-9e3d" includeChildForces="true" includeChildSelections="true"/>
