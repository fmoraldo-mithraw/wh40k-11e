        <selectionEntry type="upgrade" import="true" name="Annihilation" hidden="false" id="11bc-69e7-1e16-089d">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="86e8-1db1-977e-7104" includeChildSelections="true"/>
