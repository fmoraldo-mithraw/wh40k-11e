        <profile id="7797-8174-31bb-6e9f" name="Captain-General (Aura)" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" id="1086-6bc1-a07d-780d" hidden="false" typeId="9b8f-694b-e5e-b573">Friendly **^^Adeptus Custodes^^** units (excluding **^^Monster^^**/**^^Vehicle^^** units) within 6&quot; of this model can:
■ Re-roll **hit rolls** of 1.
■ Re-roll **wound rolls** of 1.</characteristic>
          </characteristics>
        </profile>
        <profile id="0d01-a562-a398-9775" name="Moment Shackle" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" id="6ce7-db1f-e8d-7489" hidden="false" typeId="9b8f-694b-e5e-b573">**Once per battle, per army.** At the start of any phase, you can select one of the following to take effect until the end of the phase:
■ This model&apos;s Watcher&apos;s Axe weapon has +3 **A**.
■ This model has 3+ **InSv**.</characteristic>
          </characteristics>
        </profile>
        <profile id="1c7d-a4c8-80f6-b654" name="Supreme Commander" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this model is in your army, it must be your **^^Warlord^^**.</characteristic>
          </characteristics>
        </profile>
