invuln: 5+</comment>
      <profiles>
        <profile id="e3eb-3331-b91f-eeb5" name="Ares Gunship" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">20+&quot;</characteristic>
