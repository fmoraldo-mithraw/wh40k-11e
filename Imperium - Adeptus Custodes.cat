        <selectionEntry type="upgrade" import="true" name="Shadow of the Throne" hidden="false" id="4dbd-ba29-a9d0-e8c4">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1832-0cb4-542f-95c0" includeChildSelections="true"/>
