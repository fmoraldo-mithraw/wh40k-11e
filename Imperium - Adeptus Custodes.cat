              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Complete two battles in which you have destroyed four or more units by the start of the third battle round.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
