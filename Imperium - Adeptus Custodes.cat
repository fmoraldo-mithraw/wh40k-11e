                <condition type="greaterThan" value="50" field="selections" scope="self" childId="2dbf-4d49-5d74-85c9" shared="true" includeChildSelections="true"/>
              </conditions>
            </modifier>
          </modifiers>
          <comment>Crusade modifiers</comment>
        </modifierGroup>
      </modifierGroups>
    </selectionEntry>
    <selectionEntry id="0574-f558-2957-584f" name="Warlord" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3625-fc31-9e05-c2d8" type="max"/>
      </constraints>
      <categoryLinks>
        <categoryLink id="37bc-7932-4cad-c278" name="Warlord" hidden="false" targetId="5c0e-4c31-d51b-e470" primary="false"/>
      </categoryLinks>
