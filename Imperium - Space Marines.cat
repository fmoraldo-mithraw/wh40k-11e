        <profile name="Leader" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="6e66-2c98-4726-d12d">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:

■ Assault Intercessor Squad
■ Bladeguard Veteran Squad
■ Company Heroes
■ Crusader Squad
■ Deathwatch Veterans
■ Decimus Kill Team
■ Desolation Squad
■ Fortis Kill Team
■ Hellblaster Squad
■ Infernus Squad
■ Inner Circle Companions
■ Intercessor Squad
■ Sternguard Veteran Squad
■ Sword Brethren Squad
■ Victrix Honour Guard</characteristic>
          </characteristics>
        </profile>
        <profile name="Strategic Acumen" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="c481-5339-4f57-2a2d">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Command phase, you can use this ability. If you do, select one combat doctrine to be active for this unit until the start of your next Command phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Finest Hour (Once per battle, per unit)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="043e-8b23-1fb8-007a">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In the Fight phase, when this unit is selected to fight, you can use this ability. If you do, this model’s melee attacks have:
■ +3 A.
■ **[DEVASTATING WOUNDS]**.</characteristic>
          </characteristics>
        </profile>
