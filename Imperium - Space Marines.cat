            <selectionEntry type="upgrade" import="true" name="Prescience" hidden="false" id="e096-95ba-7196-6dec">
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="6d28-3b44-6977-eabc" primary="false" name="Enhancement"/>
