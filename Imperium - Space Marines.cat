                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">ADEPTUS ASTARTES model only. This unit has -3&quot; detection range.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="137d-4fe1-98a5-955b" includeChildSelections="true" includeChildForces="true"/>
