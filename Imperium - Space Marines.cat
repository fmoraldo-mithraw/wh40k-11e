    <selectionEntry type="upgrade" import="true" name="Master of the Deathwing" hidden="false" id="6a76-8e86-d359-d596">
      <profiles>
        <profile name="Master of the Deathwing" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="57ba-51b5-0700-bd06">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Terminator Captain^^** model only. Once per battle, after selecting your Oath of Moment target, you can use this ability. If you do, until the start of your next Command phase, each time this model&apos;s unit makes an attack that targets your Oath of Moment target, add 1 to the Wound roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
        <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="20"/>
      </costs>
      <comment>Crusade content - Dark Angels only</comment>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="8687-2a16-ed3e-37d3" includeChildSelections="true"/>
      </constraints>
    </selectionEntry>
