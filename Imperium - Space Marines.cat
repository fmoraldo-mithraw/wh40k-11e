                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Death Company model only. Once per battle at the end of the Fight phase, if the bearer is within Engagement Range of three or more enemy models. the bearer can fight one additional time.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="f94c-e915-4af9-6984" primary="false" name="Enhancement"/>
