              <profiles>
                <profile name="The Raven&apos;s Eyes" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="5966-d4c7-d9e9-8dc1">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Ravenwing^^** model only. The bearer&apos;s unit can ignore any or all modifiers to its Move characteristic and to Advance and Charge rolls made for it.</characteristic>
