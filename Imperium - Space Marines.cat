                  <conditions>
                    <condition type="lessThan" value="1" field="forces" scope="roster" childId="cac3-71d1-ea4b-795d" shared="true" includeChildSelections="true"/>
                    <condition type="lessThan" value="1" field="selections" scope="roster" childId="d2dc-693e-b491-b16d" shared="true" id="ecc4-ce8a-24dc-b19b" includeChildSelections="true" includeChildForces="true"/>
