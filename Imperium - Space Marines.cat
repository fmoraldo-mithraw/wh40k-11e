          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Execute and Redeploy" hidden="false" id="2593-dacd-b635-277b">
              <profiles>
                <profile name="Execute and Redeploy" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="df38-e37a-b966-3ed5">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Phobos model only. In your Shooting phase, after the bearer&apos;s unit has shot, if that unit is not within Engagement Range of one or more enemy units, it can make a Normal move of up to 6&quot;. If it does until the end of the turn, that unit is not eligible to delcare a charge. This cannot allow the bearer&apos;s unit to move more than once in your Shooting phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="7295-ed65-8ff4-7a5f" shared="true" id="f105-7374-6188-7806" includeChildSelections="true" includeChildForces="true"/>
