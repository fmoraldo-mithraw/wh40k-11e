                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Space Wolves^^** model only. At the start of the Fight phase, if there are more enemy models than friendly models wholly within 6&quot; of the bearer, until the end of the phase, add 2 to the Attacks characteristic of melee weapons equipped by the bearer. If the bearer&apos;s unit has achieved one or more Boasts, add 3 to the Attacks characteristic instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Skjald" hidden="false" id="8527-5af1-190a-afa0">
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="15"/>
                <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="0"/>
