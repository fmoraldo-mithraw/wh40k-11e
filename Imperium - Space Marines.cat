            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Stalwart Champion" hidden="false" id="d872-ffd0-6f4e-8ab2">
              <profiles>
                <profile name="Stalwart Champion" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3a2e-b7c6-c018-c628">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Captain, Chaplain or Lieutenant model only. While the bearer’s unit is not Battle‑shocked, add 1 to the Objective Control characteristic of models in the bearer’s unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="433a-5e58-586b-2b7d" primary="false" name="Enhancement"/>
              </categoryLinks>
