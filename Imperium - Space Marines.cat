                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Death Company Model only. Once per battle, at the start of the Fight Phase, if the bearer is within Engagement Range of one or more enemy Character units, you can select one of those Character units and roll six D6: for each 4+, one Character model in that unit suffers 1 mortal wound.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="ae55-c655-137f-5062" primary="false" name="Enhancement"/>
