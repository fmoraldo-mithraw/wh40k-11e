            <selectionEntry type="upgrade" import="true" name="Champion of Humanity" hidden="false" id="f294-9f4d-2ea4-cb67">
              <profiles>
                <profile name="Champion of Humanity" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="8c2f-4e67-9d46-697b">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Tacticus model only. While the bearer is leading a unit, models in that unit can ignore any or all modifiers to their characteristics and/or to any roll or test made for them (excluding modifiers to saving throws).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="5179-8ede-45e3-49a2" shared="true" id="9765-f00a-3f16-c720" includeChildSelections="true" includeChildForces="true"/>
                  </conditions>
