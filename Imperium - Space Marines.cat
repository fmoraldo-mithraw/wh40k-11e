            <selectionEntry type="upgrade" import="true" name="War-tempered Artifice" hidden="false" id="f712-af03-53bd-f9dd">
              <comment>sim-mod: source=&quot;War-tempered Artifice&quot; str=+3 when=melee scope=model</comment>
              <profiles>
