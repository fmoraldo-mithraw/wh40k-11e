                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Tacticus Apothecary^^** model only. While this model is leading a unit, models in that unit have the Feel No Pain 5+ ability.</characteristic>
                  </characteristics>
