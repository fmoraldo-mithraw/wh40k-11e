              <profiles>
                <profile name="Master of the Codex" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="f132-2302-a5f7-8112">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, after you have selected your Oath of Moment target, select a second enemy unit. Until the start of your next Command phase, that second enemy unit also counts as your Oath of Moment target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
