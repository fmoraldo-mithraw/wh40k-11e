                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Adeptus Astartes Jump Pack model only. Improve the Armour Penetration characteristic of the bearer’s weapons by 1, and the bearer has a Save characteristic of 2+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="6ff6-6347-b9ef-c5d3" primary="false" name="Enhancement"/>
