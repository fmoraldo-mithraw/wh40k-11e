                <profile name="Blood Shard" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="afaf-1917-ca73-e665">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Death Company model only. The first time the bearer is destroyed, at the end of the phase, roll one D6: on a 2+, set the bearer back up on the battlefield as close as possible to where it was destroyed and not within Engagement Range of any enemy units, with 3 wounds remaining.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="3cf3-c6ce-c492-79f0" primary="false" name="Enhancement"/>
