            <selectionEntry type="upgrade" import="true" name="Gift of Foresight" hidden="false" id="3daa-03be-5449-710e">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="9a72-0cac-39fc-6014" includeChildSelections="true" includeChildForces="true"/>
              </constraints>
              <profiles>
                <profile name="Gift of Foresight" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3243-c799-ac6f-1cef">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Adeptus Astartes model only. Once per battle round, just after making a Hit roll, a Wound roll or a saving throw for the bearer, you can treat the result as a unmodified 6 instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
