        <selectionEntryGroup name="Black Spear Task Force Enhancements" hidden="false" id="c76e-1399-2a53-3df2" publicationId="4115-3627-e608-39f6" page="5">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Thief of Secrets" hidden="false" id="d4ed-181-c948-c9e6" publicationId="4115-3627-e608-39f6">
              <comment>sim-mod: source=&quot;Thief of Secrets&quot; str=+1 ap=+1 dmg=+1 when=melee scope=model choice=&quot;Thief of Secrets&quot;
sim-mod: source=&quot;Thief of Secrets (a tué)&quot; str=+2 ap=+2 dmg=+2 when=melee scope=model conditional choice=&quot;Thief of Secrets&quot;</comment>
              <profiles>
                <profile name="Thief of Secrets" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ef5c-295b-6117-663c">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Adeptus Astartes^^** model only. Improve the Strength, Damage and Armour Penetration characteristics of the bearer’s melee weapons by 1. At the end of the Fight phase, if one or more enemy models were destroyed as a result of a melee attack made by the bearer this phase, until the end of the battle, improve the Strength, Damage and Armour Penetration characteristics of the bearer’s melee weapons by 2 instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9dc-71d1-fc7f-57d8"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="b831-977a-e0c9-1efd" includeChildSelections="true"/>
              </constraints>
              <categoryLinks>
