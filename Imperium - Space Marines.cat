                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Adeptus Astartes Infantry^^** model only. Add 3 to the Strength characteristic of the bearer&apos;s melee weapons.</characteristic>
                  </characteristics>
