              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Void Sailor" hidden="false" id="934b-8eb4-5d18-7164">
          <profiles>
            <profile name="Void Sailor" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="e1eb-7d9c-dd12-302a">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the end of the battle, in the Determine Victor step, if this model is wholly within your opponent&apos;s deployment zone, roll one D6, adding 2 to the result if you won the battle: on a 4+, you gain 1RP.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="10"/>
