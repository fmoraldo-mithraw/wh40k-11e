              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="10"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Forged in Battle" hidden="false" id="ee22-85d2-b3c0-4b8d">
              <profiles>
                <profile name="Forged in Battle" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="e0ed-2d38-8406-9107">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Adeptus Astartes model only. While the bearer is leading a unit, once per turn, after making a Hit roll or a saving throw for a model in that unit, you can change the result of that roll to an unmodified 6.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="42f8-16d3-c6ce-3186" includeChildSelections="true"/>
              </constraints>
              <categoryLinks>
