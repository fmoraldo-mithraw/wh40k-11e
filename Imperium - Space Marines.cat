        <profile name="Techmarine" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="3eb3-b6eb-4967-a6b2">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">6&quot;</characteristic>
