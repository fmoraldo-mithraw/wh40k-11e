                <profile name="The Chronicle of Istrouma" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="8403-9812-2fc7-eb9d">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per battle, in your Command phase, if your Crusade force is embarked on an Oathsworn Campaign, you can change your Bonus Oathsworn Agenda for a different one from the table associated with your Oathsworn Campaign. When doing so, you do not lose any Honour points you have already gained from your current Bonus Agenda.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="e771-d193-6c33-4423" includeChildForces="true" includeChildSelections="true"/>
