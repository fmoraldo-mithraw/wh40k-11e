        </profile>
        <profile name="Transport" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a232-6e38-a6ef-b5f4">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a transport capacity of 12 **^^Adeptus Astartes Infantry^^** models. It cannot transport **^^Gravis^^**/**^^Jump Pack^^**/**^^Terminator^^** models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deployment Complete" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4d36-b9ac-2aa9-b06f">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit is set up and all units embarked within it have disembarked, units cannot embark within this unit.</characteristic>
          </characteristics>
        </profile>
