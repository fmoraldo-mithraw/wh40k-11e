          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Grimnar&apos;s Mark" hidden="false" id="b103-51cc-cef2-892b">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="force" shared="true" id="21ad-801c-b928-1ab7" includeChildSelections="true"/>
              </constraints>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="740a-892c-8958-defa" shared="true" includeChildSelections="true"/>
                        <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="2d7f-1892-2fd0-e29c" shared="true" includeChildSelections="true"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Grimnar&apos;s Mark" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="9c77-b878-b1c4-a9ef">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Adeptus Astartes Terminator Captain model only. Once per battle round, from the second battle round
onwards, you can target the bearer’s unit with the Rapid Ingress or Heroic Intervention Stratagem for
0CP, and can do so even if you have already targeted a different unit with that Stratagem this turn.


In the Declare Battle Formations step, the bearer can be attached to a Wolf Guard Terminators unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="20"/>
                <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
                <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="0"/>
                <cost name="Relic Fragments" typeId="0ece-6541-4662-ece2" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Howlmaw" hidden="false" id="df8c-0892-36bd-0f71">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="force" shared="true" id="1807-fac8-bfe3-b96a" includeChildSelections="true"/>
              </constraints>
              <profiles>
                <profile name="Howlmaw" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4087-7d92-498f-a0bb">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Wolf priest model only. At the start of the Fight phase, you can select one enemy unit within 6&quot; of the
bearer. That unit must take a Battle-shock, subtracting 1 from the result.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="e700-e90e-8379-035f" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="15"/>
                <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
                <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="0"/>
                <cost name="Relic Fragments" typeId="0ece-6541-4662-ece2" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Chariots of the Storm" hidden="false" id="048e-cf4e-5057-76fe">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="force" shared="true" id="29d3-5010-b33e-471b" includeChildSelections="true"/>
              </constraints>
              <profiles>
                <profile name="Chariots of the Storm" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="324b-5014-d2e9-86fc">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Adeptus Astartes model only. After both players have deployed their armies, select up to three Adeptus Astartes units from your army and redeploy them. When doing so, you can set those units up in Strategic Reserves, regardless of how many units are already in Strategic Reserves.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="25"/>
                <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
                <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="0"/>
                <cost name="Relic Fragments" typeId="0ece-6541-4662-ece2" value="0"/>
