            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has the psychic abilities listed in the Psychic Abilities section.</characteristic>
          </characteristics>
        </profile>
        <profile name="Veil of Time (psychic level 1)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="d305-377f-7c44-aab9">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this unit is selected to make an advance move, if this unit is not battle-shocked, you can make a psychic roll for this unit by rolling one D6. If you do:
■ On a 1, this unit is battle-shocked.
■ This unit can change that advance roll to a 6.</characteristic>
          </characteristics>
        </profile>
        <profile name="Force Dome (psychic level 1)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="286e-5d09-05c1-4641">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Movement phase, if this unit is not battle-shocked, you can make a psychic roll for this unit by rolling one D6. If you do:
■ On a 1, this unit is battle-shocked.
■ This unit has 4+ InSv until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psychic Hood (Psychic)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="6b14-022d-22bb-0c32">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit has Feel No Pain 4+ against psychic attacks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
