        <selectionEntryGroup name="Gladius Task Force Enhancements" hidden="false" id="dff5-fd4c-749d-e42">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Artificer Armour" hidden="false" id="e57e-d55a-be75-2205">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="6d91-8bba-9b7d-e8a1" includeChildSelections="true" includeChildForces="true"/>
              </constraints>
              <profiles>
                <profile name="Artificer Armour" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="420d-447-d2c3-42fc">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Adeptus Astartes^^** model only. The bearer has a Save characteristic of 2+ and the Feel No Pain 5+ ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="4b65-06f8-ad4d-fe3a" primary="false" name="Enhancement"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Feel No Pain" id="84bb-e22f-709c-23db" hidden="false" type="rule" targetId="9bf4-280f-bbe2-6fbb">
                  <modifiers>
                    <modifier type="append" value="5+" field="name" join=" "/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <modifierGroups>
                <modifierGroup type="and">
                  <modifiers>
                    <modifier type="append" value="Artificer Armour" field="annotation" join=", " scope="model" affects="self.entries.recursive.9cfd-1c32-585f-7d5c.profiles.Unit"/>
                    <modifier type="set" value="2+" field="450-a17e-9d5e-29da" join=", " scope="model" affects="self.entries.recursive.9cfd-1c32-585f-7d5c.profiles.Unit"/>
                  </modifiers>
                </modifierGroup>
              </modifierGroups>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Honour Vehement" hidden="false" id="899b-69cc-2e8f-f8ea">
              <comment>sim-mod: source=&quot;The Honour Vehement&quot; attacks=+1 str=+1 when=melee scope=model choice=&quot;The Honour Vehement&quot;
sim-mod: source=&quot;The Honour Vehement (Assaut)&quot; attacks=+2 str=+2 when=melee scope=model conditional choice=&quot;The Honour Vehement&quot;</comment>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="e43-f09-f7eb-c73b" includeChildSelections="true" includeChildForces="true"/>
              </constraints>
              <profiles>
                <profile name="The Honour Vehement" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="d8f9-1a3b-909a-5298">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Adeptus Astartes^^** model only. Add 1 to the Attacks and Strength characteristics of the bearer’s melee weapons. While the bearer is under the effects of the Assault Doctrine, add 2 to the Attacks and Strength characteristics of the bearer’s melee weapons instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="1046-cffd-1674-d143" primary="false" name="Enhancement"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="15"/>
              </costs>
              <modifierGroups>
                <modifierGroup type="and">
                  <modifiers>
                    <modifier type="append" value="The Honour Vehement" field="annotation" join=", " scope="model" affects="self.entries.recursive.profiles.Melee Weapons"/>
                    <modifier type="increment" value="1" field="ab33-d393-96ce-ccba" scope="model" affects="self.entries.recursive.profiles.Melee Weapons"/>
                    <modifier type="append" value="+0" field="2337-daa1-6682-b110" scope="model" affects="self.entries.recursive.e993-e086-6de1-12af.profiles.Melee Weapons" arg="+0" join=""/>
                    <modifier type="replace" field="2337-daa1-6682-b110" scope="model" affects="self.entries.recursive.6337-b83b-0d1e-5770.profiles.Melee Weapons" arg="+0"/>
                    <modifier type="increment" value="1" field="2337-daa1-6682-b110" scope="model" affects="self.entries.recursive.profiles.Melee Weapons" position="-1"/>
                    <modifier type="decrement" value="1" field="2337-daa1-6682-b110" scope="model" affects="self.entries.recursive.84c4-6d1e-e724-bd6e.profiles.Melee Weapons" position="-1"/>
                    <modifier type="replace" field="2337-daa1-6682-b110" scope="model" affects="self.entries.recursive.profiles.Melee Weapons" arg="+0"/>
                    <modifier type="add" value="6337-b83b-0d1e-5770" field="category" scope="model" arg="+0" affects="self.entries.recursive.e993-e086-6de1-12af"/>
                  </modifiers>
                </modifierGroup>
              </modifierGroups>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Adept of the Codex" hidden="false" id="c0aa-7c93-7b8f-5585">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1d9c-7724-6f17-3943" includeChildSelections="true" includeChildForces="true"/>
              </constraints>
              <profiles>
                <profile name="Adept of the Codex" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="e89b-8acc-fbf3-b69a">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Captain model only. At the start of your Command phase, if the bearer is on the battlefield, instead of selecting a Combat Doctrine to be active for your army, you can select the Tactical Doctrine. If you do, until the start of your next Command phase, that doctrine is active for the bearer’s unit only, even if you have already selected that doctrine to be active for your army this battle.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="2d7f-1892-2fd0-e29c" shared="true" id="3424-fb4-9dc9-e75"/>
                  </conditions>
                </modifier>
              </modifiers>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="3458-875f-3423-69ff" primary="false" name="Enhancement"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="20"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Fire Discipline" hidden="false" id="3635-6f41-c807-71c2">
              <comment>sim-mod: source=&quot;Fire Discipline&quot; sustained=1 when=ranged whileLeading</comment>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="31c6-858f-c009-da2d" includeChildSelections="true" includeChildForces="true"/>
              </constraints>
              <profiles>
                <profile name="Fire Discipline" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="a771-3ed1-239c-1185">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Adeptus Astartes model only. While the bearer is leading a unit, ranged weapons equipped by models in that unit have the [SUSTAINED HITS 1] ability. In addition, while the bearer’s unit is under the effects of the Devastator Doctrine, you can re-roll Advance rolls made for that unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="f6a5-c63b-6010-495f" primary="false" name="Enhancement"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="25"/>
                <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
