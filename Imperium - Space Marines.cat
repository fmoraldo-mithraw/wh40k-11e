            <selectionEntry type="upgrade" import="true" name="Archeotech Armament" hidden="false" id="fc2c-d48f-7737-e6a3">
              <profiles>
                <profile name="Archeotech Armament" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3b0d-9a29-6ab9-b186">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Select one ranged weapon equipped by the bearer (excluding a weapon that has been replaced by an Enhancement or upgraded using the Weapons Modifications Battle Honour). That weapon is now a Crusade Relic; improve its Strength, Armour Penetration and Damage characteristics by 1, and that weapon has the **[HAZARDOUS]** ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
