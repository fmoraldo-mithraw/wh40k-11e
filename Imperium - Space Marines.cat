        <selectionEntry type="upgrade" import="true" name="Cunning Trickster" hidden="false" id="fc26-5958-3b02-9462">
          <profiles>
            <profile name="Cunning Trickster (Aura)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ff4b-074c-644b-20e8">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time your opponent targets a unit from their Crusade army with a Stratagem, if that unit is within 12&quot; of this model, increase the cost of that usage of that Stratagem by 1CP.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="20"/>
