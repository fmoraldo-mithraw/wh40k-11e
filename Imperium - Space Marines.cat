        <selectionEntry type="upgrade" import="true" name="Elder&apos;s Wisdom" hidden="false" id="a2bb-764f-329d-dacd">
          <profiles>
            <profile name="Elder&apos;s Wisdom" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="81e8-84d5-8224-fd55">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If your Crusade army includes this model, after both players have deployed their armies, you can select this model&apos;s unit and/or one other **^^Space Wolves^^** unit from your Crusade army and redeploy them. When doing so, you can set those units up in Strategic Reserves if you wish, regardless of how many units are already in Strategic Reserves.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="20"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="c9b9-06ff-2c37-fd78" includeChildSelections="true"/>
