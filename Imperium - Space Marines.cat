                  </modifiers>
                </modifierGroup>
              </modifierGroups>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Beacon Angelis" hidden="false" id="cd83-ab05-5a76-b92b" publicationId="4115-3627-e608-39f6">
              <profiles>
                <profile name="Beacon Angelis" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="1d0c-b8c9-5b60-22b3">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">ADEPTUS ASTARTES model only. Models in the bearer’s unit have the Deep Strike ability. In addition, you can target the bearer’s unit with the Rapid Ingress Stratagem for 0CP.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a82a-c2ed-26d0-1213"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="3784-847a-ff88-1397" includeChildSelections="true"/>
              </constraints>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="b05d-7aeb-59e3-1cbf" primary="false" name="Enhancement"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="25"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Osseus Key" hidden="false" id="768c-ece8-b71d-1681" publicationId="4115-3627-e608-39f6">
              <profiles>
                <profile name="Osseus Key" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="6d2f-f39e-d284-3b7a">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">WATCH MASTER or TECHMARINE model only. At the start of your opponent’s Shooting phase, select one enemy VEHICLE unit (excluding TITANIC units) within 12&quot; of and visible to the bearer. That model must take a Leadership test. If that test is passed, until the end of the phase, each time a model in that unit makes an attack, subtract 1 from the Hit roll; if that test is failed, that unit is not eligible to shoot this phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="6e-71bd-2538-d468" shared="true" includeChildSelections="true"/>
                        <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="b957-d9cd-ee81-560" shared="true"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d307-81a7-bfe0-2532"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="260c-b1b9-547-8aa2" includeChildSelections="true"/>
              </constraints>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="a74a-ee51-71ae-2e47" primary="false" name="Enhancement"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="51b2-306e-1021-d207" value="15"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Tome of Ectoclades" hidden="false" id="fd68-a53b-19f4-59d8">
              <profiles>
                <profile name="The Tome of Ectoclades" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="bfe2-b185-ed41-789f">
                  <characteristics>
                    <characteristic name="Description" typeId="9b8f-694b-e5e-b573">WATCH MASTER or CAPTAIN model only. Once per battle, after you have selected your Oath of Moment target, the bearer can use this Enhancement. If it does, select a second enemy unit to be an Oath of Moment target. 


**Designer’s Note:** *This means that each time a model with the Oath of Moment ability makes an attack that targets either of your Oath of Moment targets, you can re-roll the Hit roll.*</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="6e-71bd-2538-d468" shared="true" includeChildSelections="true"/>
                        <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="2d7f-1892-2fd0-e29c" shared="true"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dff0-281b-cb10-995b"/>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="394-ce00-93e0-1879" includeChildSelections="true"/>
              </constraints>
              <categoryLinks>
                <categoryLink targetId="6226-9b9b-107a-9ada" id="33fd-36c4-b7d6-91ac" primary="false" name="Enhancement"/>
              </categoryLinks>
              <costs>
