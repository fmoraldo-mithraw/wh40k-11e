              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**^^Captain^^** model only. Once per battle, after selecting your Oath of Moment target, you can use this ability. If you do, until the start of your next Command phase, each time this model&apos;s unit makes a melee attack that targets your Oath of Moment target, you can re-roll the Wound roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="51b2-306e-1021-d207" value="0"/>
            <cost name="Honour Points" typeId="8135-9a2f-6627-09e2" value="20"/>
          </costs>
