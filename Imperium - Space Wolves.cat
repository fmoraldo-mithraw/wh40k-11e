        <profile name="Iron Priest" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="c945-4824-a8ed-3a20">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this model is within 3&quot; of one or more friendly ADEPTUS ASTARTES VEHICLE units, this model has the Lone Operative ability</characteristic>
          </characteristics>
        </profile>
        <profile name="Gift of the Iron Wolf" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="41bc-61e5-b4dc-1194">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Command phase, you can select one friendly ADEPTUS ASTARTES VEHICLE model within 3&quot; of this model. That model regains up to D3 lost wounds and, until the start of your next Command phase, select one ranged weapon equipped by that model to have the [RAPID FIRE 1] ability. Each model can only be selected for this ability or the Blessing of the Omnissiah ability once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="32b3-ea87-484-39ec">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model can be attached to the following units:

■ Wolfguard Headtakers
■ Blood Claws
■ Grey Hunters</characteristic>
          </characteristics>
        </profile>
        <profile name="Judgement of the Omnissiah" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0ab3-6430-d18f-c4c6">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time this model makes an attack that targets an enemy unit within Engagement Range of one or more friendly ADEPTUS ASTARTES VEHICLE units, you can re-roll the wound roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
