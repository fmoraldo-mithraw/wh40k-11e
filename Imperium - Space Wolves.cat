        <profile name="Murderfang" typeId="c547-1836-d8a-ff4f" typeName="Unit" hidden="false" id="60e4-3f4e-cbb9-c31b">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">9&quot;</characteristic>
