        </profile>
        <profile name="Primarch of the XIII (Aura)" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="e410-4870-f485-d865">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While a friendly **^^Adeptus Astartes^^** unit is within 6&quot; of this unit, that unit’s attacks can:
■ Re-roll hit rolls of 1.
■ Re-roll wound rolls of 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leader of Astartes" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3be4-de1d-6d27-6475">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">While this unit is within 3&quot; of a friendly **^^Adeptus Astartes Infantry^^** unit, this unit has **[LONE OPERATIVE]**.</characteristic>
          </characteristics>
        </profile>
