  </sharedProfiles>
  <sharedRules>
    <rule id="a07b-d883-9916-4288" name="Conversion" hidden="false">
      <description>Each time an attack made with this weapon targets a unit more than 12&quot; from the bearer, an unmodified successful Hit roll of 4+ scores a Critical Hit.</description>
    </rule>
  </sharedRules>
</catalogue>
