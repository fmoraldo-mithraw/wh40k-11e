    <profile name="Big an' Stompy" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0d1a-9f3b-7c40-b002">
<characteristics>
<characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit's melee attacks can re-roll **Hit** rolls of 1.</characteristic>
</characteristics>
    </profile>
    <profile name="Transport" typeId="74f8-5443-9d6d-1f1e" typeName="Transport" hidden="false" id="0d1a-9f3b-7c40-b040">
<characteristics>
<characteristic name="Capacity" typeId="30f2-be70-861d-1b84">This model has a transport capacity of 12 **^^Orks Infantry^^** models. It cannot transport **^^Ghazghkull Thraka^^** models. Each **^^Mega Armour^^** or **^^Jump Pack^^** model takes up the space of 2 models.</characteristic>
</characteristics>
