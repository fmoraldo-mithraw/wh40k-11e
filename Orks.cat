      <profiles>
        <profile name="Ammo Runts" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="ab60-c8c9-453a-2345">
          <characteristics>
            <characteristic name="Description" id="a8e6-eada-cc59-9593" hidden="false" typeId="9b8f-694b-e5e-b573">**Once per battle, per unit.** In your Shooting phase, when this unit is selected to shoot, you can use this ability. If you do, this unit&apos;s ranged attacks have +1 **to Hit** rolls.

Place any number of Ammo Runt tokens next to the unit, removing them when this ability is used.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tide of Muscle" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="4e0-4f2f-eacc-24a0">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In the Fight phase, if this unit made a **charge move** this turn, this unit&apos;s melee attacks have the **[LETHAL HITS]** ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Never Too Busy to Fight" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0d1a-9f3b-7c40-1e01">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Being **engaged** does not prevent this unit from being eligible to start an action.</characteristic>
          </characteristics>
        </profile>
      </profiles>
