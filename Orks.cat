      <profiles>
        <profile name="Rokkit Barrage" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="3cc7-9354-9886-729">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In your Shooting phase, when this unit has shot, select one enemy unit hit by those attacks. That unit takes a **Battle-shock test**, subtracting 1 from that Battle-shock test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bomb Squigs" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="1ea4-3804-49fa-3c0a">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">**Once per turn, twice per battle, per unit.** In your Movement phase, when this unit ends a **normal move**, you can select one visible enemy unit within 12&quot; of this unit and roll one D6:
- On a 3+, that enemy unit suffers D3 mortal wounds.

Place two Bomb Squig tokens next to the unit, removing one each time this ability is used.</characteristic>
          </characteristics>
        </profile>
        <profile name="Pulsa Rokkit" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="0d1a-9f3b-7c40-7f90"/>
      </profiles>
