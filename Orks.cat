                <categoryLink name="Smoke" hidden="false" id="558c-3121-004d-5e96" targetId="6df-937-16bc-8c1a" primary="false"/>
              </categoryLinks>
              <infoLinks>
                <infoLink name="Ignores Cover" id="8434-e7b3-1de6-af6b" hidden="false" type="rule" targetId="4640-43e7-30b-215a"/>
                <infoLink name="Hazardous" id="319c-2e62-b484-4685" hidden="false" type="rule" targetId="8367-374c-f87-c627"/>
              </infoLinks>
            </selectionEntry>
