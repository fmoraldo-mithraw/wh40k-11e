    <selectionEntry type="model" import="true" name="Searchlight" hidden="false" id="61f3-ff33-ec7a-3546">
      <profiles>
        <profile name="Enemy Spotted" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="f259-0a73-856e-7f0d">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a model from your army makes a ranged attack that targets an enemy unit that is within 9&quot; of and visible to any Searchlights from your army, re-roll a Hit of 1 and, if the model making that attack is a Sentry Gun, add 1 to the Hit roll as well.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wall" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="de01-a5f9-74d5-29bf">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model is a terrain feature and counts as a Wall.</characteristic>
          </characteristics>
        </profile>
        <profile name="Camera Network" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities" hidden="false" id="d311-42fc-3963-6017">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In the Create the Battlefield and Place Objective Markers step, set this terrain feature up in one of the Searchlight positions (marked D2 on the mission map) that does not already contain a Searchlight.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts" typeId="51b2-306e-1021-d207" value="10"/>
        <cost name="Blackstone Fragments" typeId="ac6b-ced3-9b5e-9a6e" value="0"/>
      </costs>
      <categoryLinks>
        <categoryLink name="Allied Units" hidden="false" id="7941-6aa3-56f9-4a99" targetId="887b-ab87-92a2-20f5" primary="true"/>
